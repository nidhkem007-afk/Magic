<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05030D">

    <!-- ================= MAIN MAGIC SCREEN ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#05030D">

        <!-- Futuristic header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:background="#080511">

            <!-- Menu -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_magic"
                android:background="@android:color/transparent"
                android:contentDescription="Open menu"
                android:padding="12dp" />

            <!-- Magic logo -->
            <ImageView
                android:id="@+id/magicLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/magic_logo"
                android:contentDescription="Magic logo" />

            <!-- Title -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAGIC"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR AI COMPANION"
                    android:textColor="#8D78B8"
                    android:textSize="9sp"
                    android:letterSpacing="0.12" />

            </LinearLayout>

            <TextView
                android:id="@+id/modelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● QWEN"
                android:textColor="#B875FF"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

        </LinearLayout>


        <!-- ================= CHAT ================= -->

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Futuristic welcome -->
                <LinearLayout
                    android:id="@+id/welcomeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">

                    <ImageView
                        android:layout_width="105dp"
                        android:layout_height="105dp"
                        android:src="@drawable/magic_logo"
                        android:contentDescription="Magic Core" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="How can I help you?"
                        android:textColor="#F4ECFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Chat • Think • Create • Together"
                        android:textColor="#82719C"
                        android:textSize="12sp"
                        android:letterSpacing="0.06" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- ================= INPUT ================= -->

        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:background="#07040E">

            <ImageButton
                android:id="@+id/btnVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_magic_voice"
                android:background="@android:color/transparent"
                android:contentDescription="Voice"
                android:padding="10dp" />

            <EditText
                android:id="@+id/inputCommand"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="Message Magic..."
                android:textColor="#FFFFFF"
                android:textColorHint="#776B88"
                android:textSize="16sp"
                android:singleLine="false"
                android:maxLines="4"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/magic_input_background"
                android:inputType="textCapSentences|textMultiLine" />

            <ImageButton
                android:id="@+id/btnSetReminder"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="7dp"
                android:src="@drawable/ic_magic_send"
                android:background="@drawable/magic_send_background"
                android:contentDescription="Send"
                android:padding="14dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================= FUTURISTIC SIDEBAR ================= -->

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="18dp"
        android:background="#0A0613">

        <!-- Sidebar logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/magic_logo"
                android:contentDescription="Magic" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAGIC"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI COMPANION"
                    android:textColor="#9A76D8"
                    android:textSize="9sp"
                    android:letterSpacing="0.12" />

            </LinearLayout>

        </LinearLayout>


        <!-- New chat -->
        <TextView
            android:id="@+id/btnNewChat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="＋   New conversation"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/sidebar_button_background" />


        <!-- Search -->
        <TextView
            android:id="@+id/btnSearchChats"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:text="⌕   Search conversations"
            android:textColor="#B8A9C9"
            android:textSize="14sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CONVERSATIONS"
            android:textColor="#8066A5"
            android:textSize="10sp"
            android:letterSpacing="0.15" />


        <!-- Saved chats -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/savedChatsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:text="○   Welcome to Magic"
                    android:textColor="#C9BED8"
                    android:textSize="14sp" />

            </LinearLayout>

        </ScrollView>


        <!-- Bottom tools -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#241934" />

        <TextView
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:text="🧠   Memory"
            android:textColor="#C9BED8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnPersonality"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:text="✦   Personality"
            android:textColor="#C9BED8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSystemPrompt"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:text="◇   System Prompt"
            android:textColor="#C9BED8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:text="⚙   Settings"
            android:textColor="#C9BED8"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>